# Bass Station TEST17 host UI/MIDI smoke
expect page 0
# OSC1 fixed at 8': page is wave/PW/PWM source/pitch mod
turn K3 1 2
expect pwm1 1
tap EDIT
expect page 1
# PLAY on OSC2 cycles OSC2 PWM source only
tap PLAY
expect pwm2 1
expect pwm1 1
tap EDIT
expect page 2
# TEST15: SEL opens the dedicated preset browser. Browsing must not change
# the loaded sound until SEL is pressed again.
tap SEL
expect page 14
expect browse_bank 0
expect browse_preset 0
turn SELECT 1 2
expect browse_preset 1
expect preset 0
tap SEL
expect page 14
expect preset 1
expect moog 1
# REC changes the browser bank only; current sound remains loaded until SEL.
tap REC
expect browse_bank 1
expect browse_preset 0
expect bank 0
tap REC
expect browse_bank 0
tap HOME
expect page 0
# Restore INIT after the browser-load regression so the original bank traversal
# checks below keep their zero-based starting point.
turn PRESET -1 2
expect preset 0
turn SELECT 3 2
expect page 3
tap FX
expect page 4
tap ENV
expect page 5
tap ENV
expect page 6
tap ENV
expect page 7
tap LFO
expect page 8
turn K4 1 2
expect lfo_clock 1
tap GLO
expect page 9
tap GLO
expect page 10
tap GLO
expect page 11
turn SELECT 1 2
expect page 12
# TEST19: SEQ opens the expanded deterministic 303-style sequencer.
tap SEQ
expect page 13
expect seq_mode 0
expect seq_len 16
expect seq_block 0
expect seq_mut_time 2
expect seq_mut_note 2
expect seq_mut_art 3
# Dedicated MUTATE page exposes variable operation strengths.
tap SEQ
expect seq_mode 1
turn K1 1 2
turn K2 2 1
turn K3 -1 2
expect seq_mut_time 3
expect seq_mut_note 4
expect seq_mut_art 2
tap ENV
expect seq_undo 1
tap FX
expect seq_undo 0
# Full editor modes: piano roll, gate, octave/up-down, accent and slide.
tap SEQ
expect seq_mode 2
expect seq_edit 1
tap SEQ
expect seq_mode 3
tap SEQ
expect seq_mode 4
tap SEQ
expect seq_mode 5
tap SEQ
expect seq_mode 6
tap SEQ
expect seq_mode 0
tap EDIT
expect seq_mode 2
tap EDIT
expect seq_mode 0
# Browser-control SysEx drives the same sequencer state as the hardware UI.
bwctl HELLO
bwctl SEQCTRL 13 7
bwctl SEQCTRL 14 6
bwctl SEQCTRL 15 5
expect seq_mut_time 7
expect seq_mut_note 6
expect seq_mut_art 5
bwctl SEQCTRL 1 64
expect seq_len 64
bwctl STEP 1 5 2
bwctl STEP 0 77 11
expect seq_selected_kind 1
expect seq_selected_degree 3
expect seq_selected_oct 1
expect seq_selected_acc 1
expect seq_selected_slide 1
bwctl ACTION 5
expect seq_undo 1
bwctl ACTION 4
expect seq_undo 0
expect seq_selected_degree 3
# Restore the normal 16-step test baseline.
bwctl SEQCTRL 1 16
bwctl SEQCTRL 13 2
bwctl SEQCTRL 14 2
bwctl SEQCTRL 15 3
expect seq_len 16
# Browser synth parameter write is routed through the same live parameter state.
bwctl PARAM 3 1
expect sync 1
bwctl PARAM 3 0
expect sync 0
tap ARP
expect seq_block 1
tap REC
expect seq_undo 1
tap FX
expect seq_undo 0
tap PLAY
expect seq_running 1
tap PLAY
expect seq_running 0
# SEL remains the dedicated preset browser from inside the sequencer.
tap SEL
expect page 14
tap HOME
expect page 0
# INIT + complete recovered 100-program factory bank.
expect preset 0
turn PRESET 1 2
expect preset 1
expect moog 1
expect moog_wheel 1
turn PRESET 99 1
expect preset 100
expect factory_last 1
turn PRESET 1 2
expect preset 0
# Persistent USER / COMMUNITY bank. REC toggles banks; SAVE writes selected user slot.
tap REC
expect bank 1
expect preset 0
expect user_valid 0
# OSC SYNC remains editable on MIX/K2; SEQ is now the sequencer page.
tap HOME
turn SELECT 3 2
expect page 3
turn K2 1 2
expect sync 1
tap SAVE
expect user_valid 1
expect custom 0
turn PRESET 1 2
expect preset 1
expect user_valid 0
turn PRESET -1 2
expect preset 0
expect user_valid 1
expect sync 1
# SAVE also persists selected user bank/slot across reboot.
reboot
wait 100
expect bank 1
expect preset 0
expect user_valid 1
expect sync 1
# Return to factory/INIT. Moog has sync off; toggle it on and capture the exact Rack frame into user slot 11.
tap REC
expect bank 0
expect preset 0
turn PRESET 1 2
expect preset 1
expect moog 1
expect sync 0
# TEST17: oscillator SYNC is no longer on SEQ; this saved Rack frame still
# needs SYNC enabled, so edit MIX/K2 directly.
turn K2 1 2
expect sync 1
bsctl START 10
expect import 1
expect import_slot 10
rackrx
expect bank 1
expect preset 10
expect user_valid 1
expect import_slot 11
bsctl STOP
expect import 0
tap HOME
turn SELECT 3 2
expect page 3
turn K2 -1 2
expect sync 0
bsctl LOAD 10
expect bank 1
expect preset 10
expect sync 1
# TEST14 native plug-in state import preserves a 34-byte factory/plugin record without Rack clamping.
pluginrx 20 1
expect bank 1
expect preset 20
expect user_valid 1
# TEST14 expands USER storage to all 128 MIDI Program Change slots. Exercise
# the new final flash chunk and persistence at slot 128 (zero-based 127).
pluginrx 127 1
expect bank 1
expect preset 127
expect user_valid 1
tap SAVE
reboot
wait 100
expect bank 1
expect preset 127
expect user_valid 1
# MIDI Program Change 127 must address the final USER slot directly.
midi USB c0 7f 00
wait 20
expect preset 127
expect user_valid 1
# MIDI bank select: CC0=0 -> factory, non-zero -> USER. Factory PC0 is Moog Bass.
midi USB b0 00 00
wait 20
expect bank 0
midi USB c0 00 00
wait 20
expect preset 1
expect moog 1
# TEST14 native trigger decode: factory 10 is AUTO, factory 16 is SINGLE.
midi USB c0 0a 00
wait 20
expect preset 11
expect trigger 0
midi USB c0 10 00
wait 20
expect preset 17
expect trigger 1
midi USB c0 00 00
wait 20
expect preset 1
expect moog 1
midi USB b0 00 01
wait 20
expect bank 1
midi USB c0 00 00
wait 20
expect preset 0
expect user_valid 1
# Finish smoke in factory bank.
midi USB b0 00 00
wait 20
expect bank 0
# Local keyboard audio
peakreset
key w4 down 110
wait 250
expect peak_db_min -70
key w4 up 0
wait 150
# USB MIDI + pressure/breath/mod/sustain + documented plug-in CC automation
peakreset
midi USB 90 3c 70
midi USB d0 64 00
midi USB b0 02 50
midi USB b0 01 7f
# TEST14: public bipolar parameters are true -64..+63 controls; raw 0/1 must not collapse.
midi USB b0 15 00
wait 10
expect o1_lfo_cents -1200
midi USB b0 15 01
wait 10
expect o1_lfo_cents -1181
midi USB b0 15 40
wait 10
expect o1_lfo_cents 0
midi USB b0 15 7f
wait 10
expect o1_lfo_cents 1200
# TEST14: OSC2 SEMI public control is 0..+12, not signed.
midi USB b0 17 00
wait 10
expect o2_semi 0
midi USB b0 17 7f
wait 10
expect o2_semi 12
midi USB b0 10 7f
wait 20
expect lfo_fast 1
midi USB b0 6c 7f
midi USB b0 6d 7f
midi USB b0 6f 7f
wait 20
expect env20 1
midi USB b0 69 50
midi USB b0 6a 60
midi USB b0 6b 58
midi USB b0 40 7f
wait 200
expect peak_db_min -70
midi USB 80 3c 00
wait 80
expect peak_db_min -70
midi USB b0 40 00
midi USB b0 7b 00
wait 100
